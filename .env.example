# Copy to .env and fill in. `.env` is git-ignored; never commit a real key.
#
#   cp .env.example .env
#   npm run example
#
# Used by the runnable example in examples/quickstart/ and by `support-agent build-kb`.

# --- Required ---------------------------------------------------------------

# Your nRouter API key (starts with sk-nrouter-). Create one in the dashboard
# at https://app.nrouter.ai under Keys. Give this key its own budget: every
# visitor's question is billed to it.
NROUTER_API_KEY=

# --- The agent --------------------------------------------------------------

# Chat model. Any model id your key can call; see https://nrouter.ai/models.
MODEL=claude-haiku-4-5-20251001

# What the agent calls itself, and any house rules for it.
AGENT_NAME=Acme Support
AGENT_INSTRUCTIONS=Be concise and friendly. If you cannot help, suggest emailing support@example.com.

# --- Your knowledge ---------------------------------------------------------

# Folder of .md / .mdx / .txt files the agent answers from.
DOCS_DIR=examples/quickstart/docs

# Public address those files are published at; used for the source links.
DOCS_BASE_URL=https://example.com/docs

# Where the built index is stored. Delete this file to rebuild it after the docs change.
KB_PATH=kb.json

# --- Optional ---------------------------------------------------------------

# Web search, used only when the docs have no confident answer. Comma-separated
# bare hostnames to keep it on your own sites, e.g. example.com,docs.example.com
# Leave empty to turn search off. Each search is a second billed call.
WEB_SEARCH_DOMAINS=

# Offer a "book a meeting" link when a visitor asks for sales or a demo. Must be https.
BOOKING_URL=

# Where the example listens.
PORT=4175

# Gateway address. Leave empty for https://api.nrouter.ai/v1
NROUTER_BASE_URL=
